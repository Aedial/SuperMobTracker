{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Aedial/SuperMobTracker/blob/main/docs/spawn_hints.schema.json",
  "title": "Super Mob Tracker External Spawn Hints",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor schema reference; ignored by the runtime loader."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": ["entries"],
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "translationKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "description": "Translation key from an external mod."
    },
    "hintTranslationKey": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "description": "Lowercase internal translation key."
    },
    "hintItemArgument": {
      "type": "string",
      "pattern": "^item:[a-z0-9_.-]+:[a-z0-9_./-]+(@[0-9]+)?$",
      "description": "Item registry ID with optional metadata (missing @meta defaults to 0)."
    },
    "hintEntityArgument": {
      "type": "string",
      "pattern": "^entity:[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Entity registry ID."
    },
    "hintBlockArgument": {
      "type": "string",
      "pattern": "^block:[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Block registry ID. Blocks with an item support JEI actions."
    },
    "hintArgument": {
      "oneOf": [
        {
          "$ref": "#/$defs/hintItemArgument"
        },
        {
          "$ref": "#/$defs/hintBlockArgument"
        },
        {
          "$ref": "#/$defs/hintEntityArgument"
        }
      ]
    },
    "hint": {
      "oneOf": [
        {
          "$ref": "#/$defs/hintTranslationKey"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/hintTranslationKey"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/hintArgument"
              }
            }
          },
          "required": ["key", "args"]
        }
      ]
    },
    "lightLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "timeOfDayTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23999,
      "description": "Minecraft time-of-day tick within a single day cycle. Use 0-23999."
    },
    "weather": {
      "type": "string",
      "enum": ["clear", "rain", "thunder"]
    },
    "intRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "lightRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/lightLevel"
        },
        "max": {
          "$ref": "#/$defs/lightLevel"
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/timeOfDayTick"
        },
        "end": {
          "$ref": "#/$defs/timeOfDayTick"
        }
      }
    },
    "biomes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceLocation"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "BiomeDictionary.Type names such as OCEAN, SWAMP, NETHER, or END."
        },
        "allTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Alternative to 'types', when ALL of the listed types must be present in the biome."
        }
      }
    },
    "summonItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceLocation"
        },
        "metadata": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "required": ["id"]
    },
    "summon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/summonItem"
          }
        },
        "onBlock": {
          "$ref": "#/$defs/resourceLocation"
        },
        "onEntity": {
          "$ref": "#/$defs/resourceLocation"
        }
      },
      "required": ["items"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityId": {
          "$ref": "#/$defs/resourceLocation"
        },
        "parent": {
          "$ref": "#/$defs/resourceLocation",
          "description": "Optional. Inherit the fields from an existing parent entry, overriding them with the fields in this entry. Must be a declared entityId in the file."
        },
        "spawnReason": {
          "type": "string",
          "description": "Reason shown in the GUI. A missing value inherits from parent or native analysis. Known values such as worldgen, structure, spawner, event, command, and other have built-in labels."
        },
        "biomes": {
          "$ref": "#/$defs/biomes"
        },
        "dimensionId": {
          "type": "integer",
          "description": "Optional. A supplied value replaces the analyzed dimension. For a full external result, an omitted value is inferred from the resolved biome list when possible."
        },
        "dimensionName": {
          "$ref": "#/$defs/translationKey"
        },
        "groundBlocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lightLevels": {
          "$ref": "#/$defs/lightRange",
          "description": "Light levels use the vanilla Minecraft range 0-15."
        },
        "yLevels": {
          "$ref": "#/$defs/intRange"
        },
        "timeOfDay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeRange"
          },
          "description": "Time-of-day ranges in ticks, using the 0-23999 day cycle."
        },
        "weather": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weather"
          },
          "uniqueItems": true
        },
        "requiresSky": {
          "type": "boolean"
        },
        "moonPhases": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        },
        "requiresSlimeChunk": {
          "type": "boolean"
        },
        "requiresNether": {
          "type": "boolean"
        },
        "summon": {
          "$ref": "#/$defs/summon",
          "deprecated": true,
          "description": "Deprecated. Use extended hints with item and entity arguments instead."
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hint"
          }
        }
      },
      "required": ["entityId"]
    }
  }
}
